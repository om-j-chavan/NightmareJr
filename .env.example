# ── Discord ──────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → your app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Guild (server) ID used for instant slash-command registration during dev.
DISCORD_GUILD_ID=

# ── Spotify ──────────────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard → your app
# Add this exact redirect URI in the dashboard: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Produced by `npm run auth`. Long-lived; treat it like a password.
SPOTIFY_REFRESH_TOKEN=

# ── Sync tuning ──────────────────────────────────────────────────────────
# How often to poll Spotify for playback state, in ms.
# Lower is more responsive to skips; 1000 is the floor this app allows.
POLL_INTERVAL_MS=1000

# Re-seek the Discord stream when it drifts from Spotify by more than this.
DRIFT_TOLERANCE_MS=2500

# Compensates for API + network + ffmpeg startup latency when seeking.
SEEK_LATENCY_MS=800

LOG_LEVEL=info
